{
  "name": "graduation-management-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --base=./",
    "preview": "vite preview",
    "test": "node test/run.js",
    "format": "prettier --write --ignore-path .prettierignore \"src/**/*.{js,jsx}\" \"test/**/*.js\" \"cloudflare-worker/src/**/*.js\" && prettier --write --ignore-path .prettierignore --parser babel \"apps-script/**/*.gs\"",
    "format:check": "prettier --check --ignore-path .prettierignore \"src/**/*.{js,jsx}\" \"test/**/*.js\" \"cloudflare-worker/src/**/*.js\" && prettier --check --ignore-path .prettierignore --parser babel \"apps-script/**/*.gs\""
  },
  "dependencies": {
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
